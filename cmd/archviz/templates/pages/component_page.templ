package pages

import (
  "github.com/edanko/archviz/cmd/archviz/internal/domain"
)

templ ComponentPage(graph *domain.ComponentGraph, componentID string) {
<article class="component-page">
  // Component Info Block
  <section class="component-info">
    <h2>Component Details</h2>
    <div class="info-grid">
      <div class="info-item">
        <label>Name:</label>
        // <span>{ graph.GetComponent(componentID).Title }</span>
      </div>
      <div class="info-item">
        <label>Description:</label>
        // <span>{ graph.GetComponent(componentID).Description }</span>
      </div>
      <div class="info-item">
        <label>Type:</label>
        // <span>{ graph.GetComponent(componentID).Type }</span>
      </div>
      <div class="info-item">
        <label>Namespace:</label>
        // <span>{ graph.GetComponent(componentID).getNamespace(2) }</span>
      </div>
    </div>
  </section>

  // SVG Render Block
  <section class="component-render">
    <h2>Component View</h2>
    @ComponentRenderBlock()
  </section>

  // Links Table
  <section class="component-links">
    <h2>Links</h2>
    <table>
      <thead>
        <tr>
          <th>Source</th>
          <th>Target</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        // @foreach link in graph.links[componentID] {
        // <tr>
        //   <td>{ link.SourceID }</td>
        //   <td>{ link.TargetID }</td>
        //   <td>{ link.Description }</td>
        // </tr>
        // }
        // @if len(graph.links[componentID]) == 0 {
        // <tr>
        //   <td colspan="3">No links found</td>
        // </tr>
        // }
      </tbody>
    </table>
  </section>

  // Additional Info Blocks
  <section class="additional-info">
    <h2>Additional Information</h2>
    // @ComponentPropertiesBlock(graph.GetComponent(componentID).Properties)
    // @ComponentTagsBlock(graph.GetComponent(componentID).Tags)
  </section>
</article>
}

// ComponentRenderBlock - placeholder for SVG render implementation
templ ComponentRenderBlock() {
<div class="svg-container">
  <!-- SVG render will go here -->
  <p>SVG visualization not implemented yet</p>
</div>
}

// ComponentPropertiesBlock displays component properties
templ ComponentPropertiesBlock(properties map[string]any) {
<div class="properties-block">
  <h3>Component Properties</h3>
  // @foreach key, value in properties {
  // <div class="property-item">
  //   <label>{ key }:</label>
  //   <span>{ value }</span>
  // </div>
  // }
</div>
}

// ComponentTagsBlock displays component tags
templ ComponentTagsBlock(tags map[string]string) {
<div class="tags-block">
  <h3>Component Tags</h3>
  // @foreach key, value in tags {
  // <div class="tag-item">
  //   <span>{ key }: { value }</span>
  // </div>
  // }
</div>
}